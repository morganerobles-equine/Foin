rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Remplacer par l'adresse Google de l'enseignante (la même que TEACHER_EMAIL dans index.html)
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == "ADRESSE-GOOGLE-DE-L-ENSEIGNANTE@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // État de la séance (étape en cours, corrigé, réponse du groupe) : tout le monde lit, seule l'enseignante écrit.
    match /live/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Réponses des 5 étudiants : un document par étudiant.
    match /answers/{key} {
      allow read: if true;
      allow delete: if isTeacher();
      allow create, update: if isTeacher() || (
        request.auth != null
        && key in ['margaux', 'valentin', 'cecile', 'sandrine', 'laure']
        && request.resource.data.keys().hasOnly(['t', 's', 'v', 'vw', 'r', 'e', 'd', 'a', 'k'])
      );
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
